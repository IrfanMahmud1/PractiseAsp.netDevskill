@using Demo.Models.Demo
@model IndexModel;
@{
    ViewData["Title"] = "Index";
}

@using (Html.BeginForm("Index","Demo",FormMethod.Post,new{@class = "form-style"}))
{
    <h1>HTML Helper approach</h1>
    <hr />
    <div class="form-group">
        @Html.LabelFor(model => model.Email,new{@class = "col-md-2"})
        <div class="col-md-8">
            @Html.TextBoxFor(model => model.Email,new{ @class = "form-control", type = "email"})
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.Password,new { @class = "col-mod-2"})
        <div class="col-md-8">
            @Html.PasswordFor(model => model.Password,new{ @class = "form-control", type = "password"})
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ConfirmPassword,new{ @class = "col-md-2"})
        <div class="col-md-8">
            @Html.PasswordFor(model => model.ConfirmPassword,new{@class = "form-control", type = "password"})
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-8">
            <input  type="button" class="btn btn-primary" value="Submit" />
        </div>
    </div>
}

<form asp-controller="Demo" asp-action="Index" method="post">
    <h1>Tag helper approach</h1>
    <hr />
    <div class="form-group">
    <label asp-for="Email" class="col-md-2"></label>
    <div class="col-md-8">
        <input asp-for="Email" type="" name="name" value="" />
    </div>
    </div>
    <div class="form-group">
        <label asp-for="Password" class="col-md-2"></label>
        <div class="col-md-8">
            <input asp-for="Password" type="password" name="name" value="" />
        </div>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword" class="col-md-2"></label>
        <div class="col-md-8">
            <input asp-for="ConfirmPassword" type="password" name="name" value="" />
        </div>
    </div
     <div class="form-group">
        <div class="col-md-8">
            <input  type="button" class="btn btn-primary" value="Submit" />
        </div>
    </div>
</form>

